<odoo>
    <record id="view_company_form_ras" model="ir.ui.view">
        <field name="name">res.company.form.ras</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Identifiant fiscal, à côté de l'ICE (informations générales) -->
            <field name="company_registry" position="after">
                <field name="ras_identifiant_fiscal"/>
            </field>

            <xpath expr="//notebook" position="inside">
                <page string="RAS" name="ras_page">
                    <group>
                        <field name="ras_seuil_tva"/>
                        <field name="ras_oblige_retenue_is"/>
                        <field name="ras_oblige_retenue_ir"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>