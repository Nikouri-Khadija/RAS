<odoo>
    <record id="view_product_template_form_ras" model="ir.ui.view">
        <field name="name">product.template.form.ras</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="RAS" name="ras_page">
                    <group>
                        <field name="ras_categorie" readonly="1"/>
                        <field name="ras_motif_exclusion_id"
                               readonly="1"
                               invisible="ras_categorie != 'exclu'"/>
                        <field name="ras_categorie_remuneration_id"
                               readonly="1"
                               invisible="ras_categorie != 'soumis'"/>
                        <field name="ras_soumis_tva"
                               readonly="1"
                               invisible="ras_categorie != 'soumis'"/>
                        <field name="ras_soumis_is"
                               readonly="1"
                               invisible="ras_categorie != 'soumis'"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>