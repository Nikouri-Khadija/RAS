<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ras_attestation_wizard_form" model="ir.ui.view">
        <field name="name">ras.attestation.wizard.form</field>
        <field name="model">ras.attestation.wizard</field>
        <field name="arch" type="xml">
            <form string="Attestation RAS">
                <p>Références du versement de la retenue au Trésor, reprises sur les attestations.</p>
                <group>
                    <field name="declaration_id"/>
                    <field name="date_reversement"/>
                    <field name="reference_quittance"/>
                </group>
                <footer>
                    <button string="Générer"
                            name="action_generer"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
