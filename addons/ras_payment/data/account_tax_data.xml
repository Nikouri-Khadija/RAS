<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Groupe de taxes -->
    <record id="tax_group_ras" model="account.tax.group">
        <field name="name">Retenue à la source</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- RAS TVA -->
    <record id="tax_ras_tva_75_20" model="account.tax">
        <field name="name">RAS TVA 75% (20%)</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="type_tax_use">purchase</field>
        <field name="amount_type">percent</field>
        <field name="amount">-15</field>
        <field name="tax_group_id" ref="tax_group_ras"/>
        <field name="ras_is_retenue_source" eval="True"/>
        <field name="ras_type">tva</field>
        <field name="ras_taux_legal">75</field>
        <field name="ras_taxe_tva_reference_id" model="account.tax"
               search="[('company_id', '=', ref('base.main_company')),
                        ('type_tax_use', '=', 'purchase'),
                        ('amount_type', '=', 'percent'),
                        ('amount', '=', 20)]"/>
    </record>

